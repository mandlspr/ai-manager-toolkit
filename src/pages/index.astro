---
import Base from "../layouts/Base.astro";
import { getPublishedEntries, BLOCS, BLOC_ORDER } from "../lib/entries";

const all = await getPublishedEntries();
const compte = (bloc: string) => all.filter((e) => e.data.bloc === bloc).length;
---

<Base
  titre="Accueil"
  description="Manuel opérationnel : principes durables et sourcés, cas datés qui les prouvent."
>
  <div class="accueil">
    <h1>AI Manager Toolkit</h1>
    <p class="intro">
      Un manuel qu'on consulte, qu'on filtre et qu'on imprime. Des
      <strong>principes</strong> durables et sourcés, des <strong>cas</strong> datés
      qui les prouvent. Le contenu est séparé du code : une fiche = un fichier Markdown.
    </p>

    <ul class="blocs-grille">
      {
        BLOC_ORDER.map((b) => (
          <li class="bloc-carte">
            <a href={`/${b}/`}>
              <span class="bloc-marqueur" aria-hidden="true">
                {BLOCS[b].marqueur}
              </span>
              <span class="bloc-carte-titre">{BLOCS[b].label}</span>
              <span class="bloc-carte-compte">
                {compte(b)} fiche{compte(b) > 1 ? "s" : ""}
              </span>
              <span class="bloc-carte-desc">{BLOCS[b].description}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="accueil-lien">
      <a href="/a-propos/"
        >La méthode : test de durabilité, statuts, règle de publication →</a
      >
    </p>
  </div>
</Base>

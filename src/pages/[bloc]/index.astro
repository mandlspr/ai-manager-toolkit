---
import BlocPage from "../../components/pages/BlocPage.astro";
import type { BlocId } from "../../lib/entries";

// `/cas/` has its own dedicated page (presented as evidence) — excluded here.
export function getStaticPaths() {
  return (["gouvernance", "prompts", "build", "evaluation"] as const).map(
    (bloc) => ({ params: { bloc } }),
  );
}
---

<BlocPage lang="en" bloc={Astro.params.bloc as BlocId} />

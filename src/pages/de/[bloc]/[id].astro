---
import FichePage from "../../../components/pages/FichePage.astro";
import { getCanonicalEntries } from "../../../lib/entries";

export async function getStaticPaths() {
  const canon = await getCanonicalEntries();
  return canon.map((e) => ({
    params: { bloc: e.data.section, id: e.data.id },
    props: { canonicalId: e.data.id },
  }));
}

const { canonicalId } = Astro.props;
---

<FichePage lang="de" canonicalId={canonicalId} />

---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import {
  getCanonicalEntries,
  cote,
  blocLabel,
  aReVoir,
  fmtDate,
  casQuiProuvent,
  principesProuves,
  fichesLiees,
  BLOC_ORDER,
} from "../../lib/entries";
import { T, cheminLocalise, type Langue } from "../../i18n/ui";

interface Props {
  lang: Langue;
}
const { lang } = Astro.props;
const tt = T[lang];
const lx = (p: string) => cheminLocalise(lang, p);

// A single page: every published canonical card, no pagination.
// Basis for the future PDF e-book export — one content, two renderings.
const all = await getCanonicalEntries();

const rendus = await Promise.all(
  all.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  }),
);

const groupes = BLOC_ORDER.map((bloc) => ({
  bloc,
  label: blocLabel(lang, bloc),
  items: rendus.filter((r) => r.entry.data.section === bloc),
})).filter((g) => g.items.length > 0);

const st = (k: string) => tt.optStatut[k as keyof typeof tt.optStatut];
const ty = (k: string) => tt.optType[k as keyof typeof tt.optType];
const ax = (k: string) => tt.optAxe[k as keyof typeof tt.optAxe];
---

<Base
  lang={lang}
  chemin="/impression/"
  titre={tt.print.title}
  description={tt.home.intro}
>
  <div class="impression">
    <p class="fil impression-ecran">
      <a href={lx("/")}>{tt.breadcrumbHome}</a> / {tt.print.title}
    </p>
    <h1>{tt.print.title}</h1>
    <p class="impression-ecran impression-note">{tt.print.note(all.length)}</p>

    {
      groupes.map((groupe) => (
        <section class="impression-bloc">
          <h2>{groupe.label}</h2>
          {groupe.items.map(({ entry, Content }) => {
            const d = entry.data;
            const prouves =
              d.type === "case" ? principesProuves(entry, all) : [];
            const prouvePar =
              d.type === "principle" ? casQuiProuvent(entry, all) : [];
            const dejaMontre = new Set(
              [...prouves, ...prouvePar].map((x) => x.data.id),
            );
            const lies = fichesLiees(entry, all).filter(
              (x) => !dejaMontre.has(x.data.id),
            );
            const aDesLiens =
              prouves.length + prouvePar.length + lies.length > 0;

            return (
              <article class="impression-fiche" id={d.id}>
                <header class="impression-fiche-tete">
                  <span class="cote">{cote(entry)}</span>
                  <h3>{d.title}</h3>
                </header>
                <p class="fiche-resume-lead">{d.summary}</p>

                <div class="bandeau">
                  <dl>
                    <div>
                      <dt>{tt.bandeau.statut}</dt>
                      <dd>
                        <span class={`tag statut statut-${d.status}`}>
                          {st(d.status)}
                        </span>
                        {aReVoir(d.verified.date) && (
                          <span class="tag revoir">{tt.reviewBadge}</span>
                        )}
                        <span class="tag type">{ty(d.type)}</span>
                        {d.crosscutting.map((t) => (
                          <span class="tag axe">{ax(t)}</span>
                        ))}
                      </dd>
                    </div>

                    <div>
                      <dt>{tt.bandeau.verifie}</dt>
                      <dd>
                        {fmtDate(d.verified.date, lang)} — {d.verified.by}
                      </dd>
                    </div>

                    <div>
                      <dt>
                        {d.sources.length > 1
                          ? tt.bandeau.sources
                          : tt.bandeau.source}
                      </dt>
                      <dd>
                        <ul>
                          {d.sources.map((s) => (
                            <li>
                              <span class="source-titre">{s.titre}</span>
                              <span class="source-detail">
                                {" "}
                                — {s.emplacement} · {s.nature} ·{" "}
                                {fmtDate(s.date_document, lang)}
                              </span>
                              {s.url && <span class="source-url">{s.url}</span>}
                            </li>
                          ))}
                        </ul>
                        {d.verified.scope_limit && (
                          <p class="perimetre">
                            {tt.limitedScope} : {d.verified.scope_limit}
                          </p>
                        )}
                      </dd>
                    </div>

                    {aDesLiens && (
                      <div>
                        <dt>{tt.bandeau.liens}</dt>
                        <dd>
                          {prouves.length > 0 && (
                            <p>
                              {tt.provenPrinciples}{" "}
                              {prouves.map((x, i) => (
                                <>
                                  {i > 0 && " · "}
                                  {cote(x)} — {x.data.title}
                                </>
                              ))}
                            </p>
                          )}
                          {prouvePar.length > 0 && (
                            <p>
                              {tt.provingCases}{" "}
                              {prouvePar.map((x, i) => (
                                <>
                                  {i > 0 && " · "}
                                  {cote(x)} — {x.data.title}
                                </>
                              ))}
                            </p>
                          )}
                          {lies.length > 0 && (
                            <p>
                              {tt.seeAlso}{" "}
                              {lies.map((x, i) => (
                                <>
                                  {i > 0 && " · "}
                                  {cote(x)} — {x.data.title}
                                </>
                              ))}
                            </p>
                          )}
                        </dd>
                      </div>
                    )}
                  </dl>
                </div>

                <div class="fiche-corps">
                  <Content />
                </div>
              </article>
            );
          })}
        </section>
      ))
    }
  </div>
</Base>

<style is:global>
  /* Screen rendering — same tokens and classes as the rest of the site. */
  .impression {
    max-width: 44rem;
  }
  .impression > h1 {
    font-size: 1.7rem;
    margin: 0 0 0.6rem;
  }
  .impression-note {
    font-family: var(--corps);
    font-style: italic;
    color: var(--gris-meta);
    margin: 0 0 1.5rem;
    max-width: 42rem;
  }
  .impression-bloc > h2 {
    font-family: var(--titre);
    font-weight: 800;
    font-size: 1.3rem;
    margin: 2.75rem 0 0.5rem;
    padding-bottom: 0.3rem;
    border-bottom: 2px solid var(--encre);
  }
  .impression-fiche {
    padding: 1.15rem 0 1.3rem;
    border-bottom: 1px solid var(--bordure);
    break-inside: avoid;
    page-break-inside: avoid;
  }
  .impression .fiche-corps {
    font-size: 1rem;
  }
  .impression .fiche-corps h2 {
    margin: 0.9rem 0 0.3rem;
    font-size: 1.02rem;
  }
  .impression .fiche-corps h2:first-child {
    margin-top: 0.25rem;
  }
  .impression .fiche-corps p {
    margin: 0.4rem 0;
  }
  .impression-fiche-tete {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.45rem 0.7rem;
    margin-bottom: 0.35rem;
  }
  .impression-fiche-tete h3 {
    font-family: var(--titre);
    font-weight: 700;
    font-size: 1.18rem;
    margin: 0;
  }
  .impression .bandeau {
    margin: 1rem 0 1.1rem;
  }
  .impression .source-titre {
    font-weight: 600;
  }
  .impression .source-url {
    display: block;
    color: var(--gris-meta);
    word-break: break-all;
  }

  @media print {
    .site-header,
    .site-footer,
    .skip,
    .lang-selector,
    .impression-ecran {
      display: none !important;
    }
    main {
      padding: 0 !important;
      max-width: none !important;
    }
    body {
      background: #fff;
    }
    .impression,
    .impression .bandeau,
    .impression .fiche-corps {
      max-width: none;
    }
    .impression > h1 {
      margin-bottom: 1rem;
    }
    .impression-bloc > h2 {
      break-after: avoid;
      page-break-after: avoid;
    }
    .impression-fiche {
      break-inside: avoid;
      page-break-inside: avoid;
      border-bottom: 1px solid #999;
    }
    .cote {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .tag {
      border: 1px solid #999;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    a {
      color: inherit;
      text-decoration: none;
    }
  }
</style>

---
import { T, type Langue } from "../i18n/ui";

// VISIBLE switch banner (never silent): shown when the card does not exist in
// the active language and the canonical (EN) version is served instead.
// Same visual register as the `a-resourcer` badge.
interface Props {
  lang: Langue;
}
const { lang } = Astro.props;
---

<aside class="bascule" role="note">{T[lang].bascule}</aside>

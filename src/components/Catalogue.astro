---
import {
  cote,
  BLOCS,
  aReVoir,
  casQuiProuvent,
  principesProuves,
  type Entry,
} from "../lib/entries";

interface Props {
  entries: Entry[];
  all: Entry[];
  seedBloc?: string;
}

const { entries, all, seedBloc } = Astro.props;
---

<section class="catalogue" data-catalogue data-seed-bloc={seedBloc ?? ""}>
  <form class="filtres" role="search" data-filtres>
    <div class="champ-recherche">
      <label for="q">Recherche</label>
      <input
        type="search"
        id="q"
        name="q"
        placeholder="Titre, résumé, corps…  ( / pour activer )"
        autocomplete="off"
        data-search-input
      />
    </div>
    <div class="facettes">
      <div class="facette" data-facette="bloc" data-mode="single" aria-label="Bloc">
        <span class="facette-label">Bloc</span>
        <div class="pastilles">
          {
            Object.entries(BLOCS).map(([k, v]) => (
              <button
                type="button"
                class="pastille"
                data-value={k}
                aria-pressed="false"
              >
                {v.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="facette" data-facette="type" data-mode="single" aria-label="Type">
        <span class="facette-label">Type</span>
        <div class="pastilles">
          <button type="button" class="pastille" data-value="principe" aria-pressed="false">Principe</button>
          <button type="button" class="pastille" data-value="cas" aria-pressed="false">Cas</button>
        </div>
      </div>

      <div class="facette" data-facette="statut" data-mode="single" aria-label="Statut">
        <span class="facette-label">Statut</span>
        <div class="pastilles">
          <button type="button" class="pastille" data-value="valide" aria-pressed="false">valide</button>
          <button type="button" class="pastille" data-value="a-resourcer" aria-pressed="false">a-resourcer</button>
          <button type="button" class="pastille" data-value="brouillon" aria-pressed="false">brouillon</button>
        </div>
      </div>

      <div class="facette" data-facette="transverse" data-mode="multi" aria-label="Axes transversaux">
        <span class="facette-label">Axes transversaux</span>
        <div class="pastilles">
          <button type="button" class="pastille" data-value="cout" aria-pressed="false">coût</button>
          <button type="button" class="pastille" data-value="hitl" aria-pressed="false">HITL</button>
          <button type="button" class="pastille" data-value="tracabilite" aria-pressed="false">traçabilité</button>
        </div>
      </div>

      <button type="button" class="pastille pastille-reset" data-reset>
        Réinitialiser
      </button>
    </div>
  </form>

  <p class="resultat-compte" data-compte>
    {entries.length} fiche{entries.length > 1 ? "s" : ""}
  </p>

  <ul class="liste-fiches" data-liste>
    {
      entries.map((e) => {
        const inv =
          e.data.type === "principe"
            ? casQuiProuvent(e, all)
            : principesProuves(e, all);
        return (
          <li>
            <a class="fiche-lien" href={`/${e.data.bloc}/${e.data.id}/`}>
              <span class="cote">{cote(e)}</span>
              <span class="fiche-titre">{e.data.titre}</span>
            </a>
            <p class="fiche-resume">{e.data.resume}</p>
            <p class="fiche-meta">
              <span class={`tag statut statut-${e.data.statut}`}>
                {e.data.statut}
              </span>
              <span class="tag type">{e.data.type}</span>
              {e.data.transverses.map((t) => (
                <span class="tag axe">{t}</span>
              ))}
              {aReVoir(e.data.verification.date) && (
                <span class="tag revoir">à revoir</span>
              )}
            </p>
            {inv.length > 0 && (
              <p class="fiche-liens">
                {e.data.type === "principe" ? "Prouvé par : " : "Prouve : "}
                {inv.map((x, i) => (
                  <>
                    {i > 0 && ", "}
                    <a href={`/${x.data.bloc}/${x.data.id}/`}>{cote(x)}</a>
                  </>
                ))}
              </p>
            )}
          </li>
        );
      })
    }
  </ul>
</section>

<script>
  import { initCatalogue } from "../scripts/catalogue";
  initCatalogue();
</script>

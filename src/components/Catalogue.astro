---
import {
  cote,
  BLOC_ORDER,
  aReVoir,
  blocLabel,
  casQuiProuvent,
  principesProuves,
  type Entry,
} from "../lib/entries";
import { T, cheminLocalise, type Langue } from "../i18n/ui";

interface Props {
  lang: Langue;
  entries: Entry[];
  all: Entry[];
  seedBloc?: string;
}

const { lang, entries, all, seedBloc } = Astro.props;
const tt = T[lang];
const lx = (p: string) => cheminLocalise(lang, p);
---

<section
  class="catalogue"
  data-catalogue
  data-lang={lang}
  data-seed-bloc={seedBloc ?? ""}
  data-t-empty={tt.empty}
  data-t-provenby={tt.listProvenBy}
  data-t-proves={tt.listProves}
  data-t-card-one={tt.cards(1).replace(/^\d+\s*/, "")}
  data-t-card-many={tt.cards(2).replace(/^\d+\s*/, "")}
  data-t-opt={JSON.stringify({
    type: tt.optType,
    statut: tt.optStatut,
    axe: tt.optAxe,
    review: tt.reviewBadge,
  })}
>
  <form class="filtres" role="search" data-filtres>
    <div class="champ-recherche">
      <label for="q">{tt.search.label}</label>
      <input
        type="search"
        id="q"
        name="q"
        placeholder={tt.search.placeholder}
        autocomplete="off"
        data-search-input
      />
    </div>
    <div class="facettes">
      <div class="facette" data-facette="bloc" data-mode="single" aria-label={tt.facet.bloc}>
        <span class="facette-label">{tt.facet.bloc}</span>
        <div class="pastilles">
          {
            BLOC_ORDER.map((k) => (
              <button
                type="button"
                class="pastille"
                data-value={k}
                aria-pressed="false"
              >
                {blocLabel(lang, k)}
              </button>
            ))
          }
        </div>
      </div>

      <div class="facette" data-facette="type" data-mode="single" aria-label={tt.facet.type}>
        <span class="facette-label">{tt.facet.type}</span>
        <div class="pastilles">
          <button type="button" class="pastille" data-value="principe" aria-pressed="false">{tt.optType.principe}</button>
          <button type="button" class="pastille" data-value="cas" aria-pressed="false">{tt.optType.cas}</button>
        </div>
      </div>

      <div class="facette" data-facette="statut" data-mode="single" aria-label={tt.facet.statut}>
        <span class="facette-label">{tt.facet.statut}</span>
        <div class="pastilles">
          <button type="button" class="pastille" data-value="valide" aria-pressed="false">{tt.optStatut.valide}</button>
          <button type="button" class="pastille" data-value="a-resourcer" aria-pressed="false">{tt.optStatut["a-resourcer"]}</button>
          <button type="button" class="pastille" data-value="brouillon" aria-pressed="false">{tt.optStatut.brouillon}</button>
        </div>
      </div>

      <div class="facette" data-facette="transverse" data-mode="multi" aria-label={tt.facet.axes}>
        <span class="facette-label">{tt.facet.axes}</span>
        <div class="pastilles">
          <button type="button" class="pastille" data-value="cout" aria-pressed="false">{tt.optAxe.cout}</button>
          <button type="button" class="pastille" data-value="hitl" aria-pressed="false">{tt.optAxe.hitl}</button>
          <button type="button" class="pastille" data-value="tracabilite" aria-pressed="false">{tt.optAxe.tracabilite}</button>
        </div>
      </div>

      <button type="button" class="pastille pastille-reset" data-reset>
        {tt.reset}
      </button>
    </div>
  </form>

  <p class="resultat-compte" data-compte>{tt.cards(entries.length)}</p>

  <ul class="liste-fiches" data-liste>
    {
      entries.map((e) => {
        const inv =
          e.data.type === "principe"
            ? casQuiProuvent(e, all)
            : principesProuves(e, all);
        return (
          <li>
            <a class="fiche-lien" href={lx(`/${e.data.bloc}/${e.data.id}/`)}>
              <span class="cote">{cote(e)}</span>
              <span class="fiche-titre">{e.data.titre}</span>
            </a>
            <p class="fiche-resume">{e.data.resume}</p>
            <p class="fiche-meta">
              <span class={`tag statut statut-${e.data.statut}`}>
                {tt.optStatut[e.data.statut as keyof typeof tt.optStatut]}
              </span>
              <span class="tag type">
                {tt.optType[e.data.type as keyof typeof tt.optType]}
              </span>
              {e.data.transverses.map((t) => (
                <span class="tag axe">
                  {tt.optAxe[t as keyof typeof tt.optAxe]}
                </span>
              ))}
              {aReVoir(e.data.verification.date) && (
                <span class="tag revoir">{tt.reviewBadge}</span>
              )}
            </p>
            {inv.length > 0 && (
              <p class="fiche-liens">
                {e.data.type === "principe"
                  ? `${tt.listProvenBy} `
                  : `${tt.listProves} `}
                {inv.map((x, i) => (
                  <>
                    {i > 0 && ", "}
                    <a href={lx(`/${x.data.bloc}/${x.data.id}/`)}>{cote(x)}</a>
                  </>
                ))}
              </p>
            )}
          </li>
        );
      })
    }
  </ul>
</section>

<script>
  import { initCatalogue } from "../scripts/catalogue";
  initCatalogue();
</script>

---
import "../styles/global.css";
import LangSelector from "../components/LangSelector.astro";
import { completionParLangue } from "../lib/entries";
import { T, cheminLocalise, type Langue } from "../i18n/ui";
import { BLOC_ORDER } from "../lib/entries";

interface Props {
  lang: Langue;
  titre: string;
  chemin: string; // locale-neutral path of the current page (e.g. /gouvernance/)
  description?: string;
}

const { lang, titre, chemin, description } = Astro.props;
const tt = T[lang];
const completion = await completionParLangue();
const lx = (p: string) => cheminLocalise(lang, p);

const nav = [
  ...BLOC_ORDER.map((b) => ({
    href: lx(b === "cases" ? "/cases/" : `/${b}/`),
    match: b === "cases" ? "/cases/" : `/${b}/`,
    label: tt.navBloc[b],
  })),
  { href: lx("/diagrams/"), match: "/diagrams/", label: tt.nav.diagrams },
  { href: lx("/quiz/"), match: "/quiz/", label: tt.nav.quiz },
  { href: lx("/a-propos/"), match: "/a-propos/", label: tt.nav.about },
];

const actif = (match: string) =>
  match === "/" ? chemin === "/" : chemin.startsWith(match);
---

<!doctype html>
<html lang={tt.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre} — AI Manager Toolkit</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Newsreader:ital,wght@0,400;0,600;1,400;1,500&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#contenu">{tt.skip}</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="wordmark" href={lx("/")}>AI Manager Toolkit</a>
        <nav class="site-nav" aria-label="Sections">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={actif(item.match) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <LangSelector lang={lang} chemin={chemin} completion={completion} />
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-inner">
        <p>
          {tt.footer} <a href={lx("/a-propos/")}>{tt.nav.about}</a> ·
          <a href={lx("/impression/")}>{tt.nav.print}</a>.
        </p>
      </div>
    </footer>

    <script>
      // "/" shortcut: focus the search field. "Esc": clear it (brief §5).
      document.addEventListener("keydown", (e) => {
        const input = document.querySelector<HTMLInputElement>(
          "[data-search-input]",
        );
        if (!input) return;
        const el = document.activeElement;
        const saisie =
          el instanceof HTMLElement &&
          ["INPUT", "TEXTAREA", "SELECT"].includes(el.tagName);
        if (e.key === "/" && !saisie) {
          e.preventDefault();
          input.focus();
        } else if (e.key === "Escape" && el === input) {
          input.value = "";
          input.dispatchEvent(new Event("input", { bubbles: true }));
          input.blur();
        }
      });
    </script>
  </body>
</html>
